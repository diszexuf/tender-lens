# =====================================================================
# Tender Lens — переменные окружения
# Скопируйте в .env и замените значения CHANGE_ME:
#   python infra/init/gen_env.py      # создаёт .env со случайными секретами
# =====================================================================

# ----- Приложение -----
# dev | prod | test
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true
# порт веб-интерфейса на хосте
WEB_PORT=8080
# порт API на хосте (для отладки и Swagger)
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tender_lens
POSTGRES_USER=tender_lens
POSTGRES_PASSWORD=CHANGE_ME

# ----- Redis (брокер задач, кэш, pub/sub) -----
REDIS_URL=redis://redis:6379/0

# ----- Garage (S3-совместимое хранилище) -----
# rpc secret: 64 hex-символа; admin/metrics token: произвольная строка
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME
GARAGE_ADMIN_URL=http://garage:3903
# ёмкость узла в layout
GARAGE_CAPACITY_GB=10

# Ключ S3 импортируется в Garage при инициализации.
# Формат: ID = "GK" + 24 hex-символа, secret = 64 hex-символа.
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_SNAPSHOTS=snapshots
S3_BUCKET_REPORTS=reports

# ----- Ollama (локальная LLM) -----
OLLAMA_URL=http://ollama:11434
# целиком в 6 ГБ VRAM; точнее, но медленнее: qwen2.5:7b
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
# одновременных запросов к GPU
LLM_MAX_CONCURRENCY=1
# Параметры сервера Ollama
OLLAMA_KEEP_ALIVE=24h
OLLAMA_FLASH_ATTENTION=1
# вдвое меньше памяти на контекст
OLLAMA_KV_CACHE_TYPE=q8_0

# ----- SearXNG (метапоиск) -----
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=CHANGE_ME

# ----- Сбор данных -----
HTTP_USER_AGENT=Mozilla/5.0 (compatible; TenderLens/0.1)
HTTP_TIMEOUT_SECONDS=20
# Домены, для которых доверяем корневому сертификату НУЦ Минцифры (zakupki.gov.ru и др.)
RU_TRUSTED_CA_HOSTS=gov.ru

# ----- ЕИС (необязательно) -----
# Токен официального сервиса отдачи данных ЕИС. Без токена используется HTML-поиск ЕПЗ.
EIS_TOKEN=
